{
  "name": "led-ticker-docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "node scripts/check-pnpm.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build-demos": "node scripts/build-demos.mjs",
    "lint": "prettier --check . && astro check",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "check:llms": "node scripts/check-llms.mjs",
    "check:tables": "node scripts/check-tables.mjs",
    "check:captions": "node scripts/check-captions.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.7",
    "astro": "^7.4.2",
    "marked": "^18.1.1",
    "sharp": "^0.35.5",
    "starlight-llms-txt": "^0.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.154.0"
  }
