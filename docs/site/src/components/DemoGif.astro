---
import { inlineCodeSegments, stripInlineCode } from "../utils/inline-code.mjs";

interface Props {
  src: string;
  caption?: string;
  alt?: string;
}
const { src, caption, alt } = Astro.props;
const altText = alt ?? (caption ? stripInlineCode(caption) : "led-ticker demo");
const segments = caption ? inlineCodeSegments(caption) : [];
---

<figure class="demo-gif">
  <img src={src} alt={altText} loading="lazy" />
  {caption && (
    <figcaption>{segments.map((s) => (s.code ? <code>{s.text}</code> : s.text))}</figcaption>
  )}
</figure>

<style>
  .demo-gif {
    margin: 1.5rem 0;
    text-align: center;
  }
  .demo-gif img {
    max-width: 100%;
    height: auto;
    image-rendering: pixelated;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 4px;
    background: black;
  }
  .demo-gif figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
  }
  .demo-gif figcaption code {
    font-size: inherit;
  }
</style>
